# G9 web / Kling adapter
KLING_MODE=mock
# KLING_MODE=live

# Auth (pick one style for live)
# KLING_API_KEY=
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# Endpoints (adjust to your Kling Open Platform portal)
KLING_BASE_URL=https://api.klingai.com
KLING_I2V_PATH=/v1/videos/image2video
KLING_QUERY_PATH=/v1/videos/{task_id}
KLING_MODEL=kling-v1
KLING_GEN_MODE=std

# Polling (live generate)
KLING_POLL_ATTEMPTS=12
KLING_POLL_MS=5000

PORT=3000

# Optional: require Bearer token on write APIs (pipeline, kling, download)
# DEPLOY_API_TOKEN=
# Rate limit (per IP / minute, default 30 for generic; pipeline uses 8)
# RATE_LIMIT_PER_MIN=30
